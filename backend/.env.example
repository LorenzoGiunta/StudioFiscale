# Variabili d'ambiente del backend.
# Copiare in un file locale NON versionato (es. .env) e impostarle nella
# configurazione di avvio (IntelliJ: Run > Edit Configurations > Environment variables,
# oppure export nel terminale prima di ./mvnw spring-boot:run).
# Con Docker lo stesso file viene passato al container tramite env_file.

# Profilo Spring: "dev" (default, sviluppo locale) oppure "docker"
# SPRING_PROFILES_ACTIVE=dev

# Database MySQL (DB_PASSWORD e' OBBLIGATORIA: nessun default nel codice).
# createDatabaseIfNotExist=true crea lo schema vuoto se manca; Flyway poi lo popola.
DB_URL=jdbc:mysql://localhost:3306/gestionalec?createDatabaseIfNotExist=true
DB_USER=root
DB_PASSWORD=root

# Segreto JWT — OBBLIGATORIO (nessun default nel codice: se manca, l'app non parte).
# Usare una stringa lunga e casuale (>= 32 caratteri / 256 bit per HS256).
JWT_SECRET=cambia-questo-segreto-con-una-stringa-random-lunga

# Email (Gmail App Password, NON la password normale dell'account)
# Lasciare EMAIL_ENABLED=false per disattivare l'invio in locale/demo.
EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Origini del frontend ammesse (CORS + WebSocket), separate da virgola.
# Default dev: http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# CORS_ALLOWED_ORIGINS=

# URL pubblico del frontend, usato nei link delle email (inviti, reset password).
# Default dev: http://localhost:5173
# FRONTEND_URL=

# Cartella dei documenti caricati. Default dev: uploads/documenti (relativa al backend)
# UPLOAD_DIR=
